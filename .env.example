# Configuration Supabase pour BunnyManager
# 
# Instructions:
# 1. Copiez ce fichier vers .env : copy .env.example .env
# 2. Remplacez les valeurs par vos vraies clés Supabase
# 3. Lancez avec: flutter run (le script run.bat chargera automatiquement)
#
# IMPORTANT: Ne commitez JAMAIS le fichier .env dans Git !

# URL de votre projet Supabase
# Trouvez-la dans: Settings > API > Project URL
SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme publique (anon key)
# Trouvez-la dans: Settings > API > Project API keys > anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.votre_cle_ici
